{
  "name": "rp-hub-private",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/", "/api/*"
    ],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rp-hub-private-db",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVES",
      "bucket_name": "rp-hub-private-archives"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "rp-hub-private-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "rp-hub-private-jobs",
        "max_batch_size": 10
      }
    ]
  }
}
